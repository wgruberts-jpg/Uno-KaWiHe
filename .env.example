# GEMINI_API_KEY is automatically injected by AI Studio.
# Leave it empty to use the injected key.
# GEMINI_API_KEY=""

# The base URL for the applet.
# In production, this should be set to your deployed app's URL.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Administration
JWT_SECRET="SEU_JWT_SECRET_AQUI"
INITIAL_ADMIN_PASSWORD="SENHA_INICIAL_ADMIN"
DATA_DIR="./data"
